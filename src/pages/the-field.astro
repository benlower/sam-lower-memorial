---
// src/pages/the-field.astro
// Toggle this to re-enable the registration CTA for future tournaments
const REGISTRATION_OPEN = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { teams, singles, MAX_FOURSOMES } from '../data/registrants';

const totalPlayers = teams.reduce((sum, t) => sum + t.players.length, 0) + singles.length;
const maxPlayers = MAX_FOURSOMES * 4;
const spotsRemaining = maxPlayers - totalPlayers;
const completeTeamsCount = teams.filter(t => t.players.length === 4).length;
const pct = totalPlayers / maxPlayers;

const displayTeams = REGISTRATION_OPEN
    ? teams
    : [...teams].sort((a, b) => {
        if (!a.teeTime && !b.teeTime) return 0;
        if (!a.teeTime) return 1;
        if (!b.teeTime) return -1;
        return a.teeTime.localeCompare(b.teeTime);
    });

function formatTeeTime(time: string) {
    const [h, m] = time.split(':').map(Number);
    const ampm = h >= 12 ? 'PM' : 'AM';
    const hour = h % 12 || 12;
    return `${hour}:${String(m).padStart(2, '0')} ${ampm}`;
}

// SVG gauge
const r = 90;
const cx = 110;
const cy = 110;
const circumference = 2 * Math.PI * r;
const dashFilled = pct * circumference;

function statusBadge(playerCount: number) {
    const open = 4 - playerCount;
    if (open === 0) return { label: 'FULL', classes: 'bg-green-100 text-green-700' };
    if (open === 1) return { label: '1 OPEN', classes: 'bg-yellow-100 text-yellow-700' };
    if (open === 2) return { label: '2 OPEN', classes: 'bg-orange-100 text-orange-700' };
    return { label: '3 OPEN', classes: 'bg-red-100 text-red-700' };
}
---

<Layout
    title="Who's Playing | The Sam Lower Memorial Golf Tournament"
    description="See who's registered for the Sam Lower Memorial Golf Tournament."
>
    <Header />

    <main class="py-16 bg-gray-50 min-h-screen">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

            <div class="mb-10">
                <h1 class="text-4xl font-bold text-gray-900 mb-2">The Field</h1>
                <p class="text-lg text-gray-500">May 15, 2026 &middot; Bear Slide Golf Club</p>
            </div>

            <!-- Gauge + stats -->
            {REGISTRATION_OPEN ? (
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 mb-10 flex flex-col items-center">
                    <svg viewBox="0 0 220 220" class="w-52 h-52 mb-6" aria-hidden="true">
                        <circle cx={cx} cy={cy} r={r} fill="none" stroke="#f3f4f6" stroke-width="18" />
                        <circle
                            cx={cx} cy={cy} r={r}
                            fill="none"
                            stroke="#16a34a"
                            stroke-width="18"
                            stroke-dasharray={`${dashFilled} ${circumference}`}
                            transform={`rotate(-90 ${cx} ${cy})`}
                            stroke-linecap="round"
                        />
                        <text x={cx} y={cy - 10} text-anchor="middle" font-size="52" font-weight="800" fill="#111827" font-family="Inter, sans-serif">{totalPlayers}</text>
                        <text x={cx} y={cy + 18} text-anchor="middle" font-size="13" fill="#9ca3af" font-family="Inter, sans-serif">players registered</text>
                    </svg>

                    <div class="flex items-center gap-8 sm:gap-12 text-center flex-wrap justify-center">
                        <div>
                            <div class="flex items-center justify-center gap-1.5 mb-1">
                                <div class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></div>
                                <p class="text-2xl font-black text-red-600">{spotsRemaining}</p>
                            </div>
                            <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold">spots remaining</p>
                        </div>
                        <div class="w-px h-10 bg-gray-200 hidden sm:block"></div>
                        <div>
                            <p class="text-2xl font-black text-gray-900 mb-1">{Math.round(pct * 100)}%</p>
                            <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold">of field claimed</p>
                        </div>
                        <div class="w-px h-10 bg-gray-200 hidden sm:block"></div>
                        <div>
                            <p class="text-2xl font-black text-gray-900 mb-1">{completeTeamsCount}</p>
                            <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold">complete teams</p>
                        </div>
                    </div>
                </div>
            ) : (
                <></>
            )}
            

            <!-- Leaderboard -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-10">
                <div class="bg-gray-900 text-white px-6 py-4 flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-gray-300">Registered Groups</span>
                    <span class="text-xs text-gray-500 font-mono">{teams.length} / {MAX_FOURSOMES} foursomes</span>
                </div>

                <div class="flex gap-4 px-6 py-2 bg-gray-50 border-b border-gray-100">
                    {!REGISTRATION_OPEN && <span class="flex-shrink-0 text-xs font-bold uppercase tracking-wider text-gray-400 w-16">Tee Time</span>}
                    <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Team</span>
                </div>

                <div class="divide-y divide-gray-100">
                    {displayTeams.map((team, i) => {
                        const badge = statusBadge(team.players.length);
                        return (
                            <div class={`flex items-start gap-4 px-6 py-4 ${i % 2 !== 0 ? 'bg-gray-50/50' : ''}`}>
                                {!REGISTRATION_OPEN && team.teeTime && (
                                    <div class="flex-shrink-0 pt-0.5">
                                        <span class="text-xs font-semibold text-green-700 bg-green-50 border border-green-200 rounded-full px-2 py-0.5 whitespace-nowrap">
                                            {formatTeeTime(team.teeTime)}
                                        </span>
                                    </div>
                                )}
                                <div class="flex min-w-0 flex-col">
                                    <div class="gap-3 mb-1">
                                        <p class="text-sm font-bold text-gray-900">{team.name ?? 'Team Name TBA'}</p>
                                    </div>
                                    <div class="flex flex-wrap gap-x-4 gap-y-0.5">
                                        {team.players.map(p => (
                                            <span class="text-sm text-gray-600">{p.name}</span>
                                        ))}
                                        {Array.from({ length: 4 - team.players.length }).map(() => (
                                            <span class="text-sm text-gray-300 italic">—</span>
                                        ))}
                                    </div>
                                </div>
                                {REGISTRATION_OPEN && (
                                    <div class="flex-shrink-0 pt-0.5">
                                        <span class={`text-xs font-bold px-2.5 py-1 rounded-full ${badge.classes}`}>
                                            {badge.label}
                                        </span>
                                    </div>
                                )}
                            </div>
                        );
                    })}
                </div>

                {MAX_FOURSOMES - teams.length > 0 && (
                    <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
                        <p class="text-sm text-gray-400 italic pl-11">{MAX_FOURSOMES - teams.length} foursome {MAX_FOURSOMES - teams.length === 1 ? 'slot' : 'slots'} still available</p>
                    </div>
                )}
            </div>

            <!-- Singles -->
            {singles.length > 0 && (
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-10">
                    <div class="bg-gray-900 text-white px-6 py-4 flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-gray-300">Looking for a Team</span>
                        <span class="text-xs text-gray-500 font-mono">{singles.length} individual{singles.length !== 1 ? 's' : ''}</span>
                    </div>
                    <div class="px-6 py-4 border-b border-gray-100">
                        <p class="text-sm text-gray-500">These players registered individually and will be placed on a team by the tournament committee.</p>
                    </div>
                    <div class="divide-y divide-gray-100">
                        {singles.map((player, i) => (
                            <div class={`flex items-center gap-4 px-6 py-3.5 ${i % 2 !== 0 ? 'bg-gray-50/50' : ''}`}>
                                <div class="w-7 flex-shrink-0 text-right">
                                    <span class="font-mono text-xs font-bold text-gray-300">{String(i + 1).padStart(2, '0')}</span>
                                </div>
                                <span class="text-sm text-gray-600">{player.name}</span>
                                <span class="ml-auto text-xs font-semibold text-blue-500 bg-blue-50 border border-blue-100 rounded-full px-2.5 py-0.5">Awaiting Team</span>
                            </div>
                        ))}
                    </div>
                </div>
            )}

            <!-- CTA -->
            {REGISTRATION_OPEN ? (
                <div class="bg-green-600 rounded-2xl p-8 text-center">
                    <h2 class="text-2xl font-bold text-white mb-2">Don't Miss the Cut</h2>
                    <p class="text-green-100 mb-6">Only {spotsRemaining} spots left. Register before the field is full.</p>
                    <a href="/#signup" class="inline-flex items-center justify-center px-6 py-3 bg-white text-green-700 font-semibold rounded-lg hover:bg-green-50 transition-colors">
                        Register Now
                    </a>
                </div>
            ) : (
                <div class="bg-green-600 rounded-2xl p-8 text-center">
                    <h2 class="text-2xl font-bold text-white mb-2">Registration is Closed</h2>
                    <p class="text-green-100">The field is set. We'll see everyone on May 15th at Bear Slide Golf Club.</p>
                </div>
            )}

        </div>
    </main>

    <Footer />
</Layout>
