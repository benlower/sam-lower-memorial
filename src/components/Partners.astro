---
// src/components/Partners.astro
import { partners } from '../data/partners';
---

{partners.length > 0 && (
    <section class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">Our Partners</h2>
                <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                    We're grateful to the following organizations for their support in making this tournament possible.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {partners.map((partner) => (
                    <div class="bg-gray-50 rounded-2xl border border-gray-100 p-6 flex flex-col">
                        {partner.logo && (
                            <div class="h-16 flex items-center mb-4">
                                <img
                                    src={partner.logo}
                                    alt={partner.name}
                                    class="max-h-full max-w-full object-contain"
                                />
                            </div>
                        )}
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">{partner.name}</h3>
                        <p class="text-sm text-gray-600 leading-relaxed flex-1">{partner.description}</p>
                        {(partner.url || partner.secondLink) && (
                            <div class="mt-4 flex flex-wrap gap-4">
                                {partner.url && (
                                    <a
                                        href={partner.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-1 text-sm font-semibold text-green-600 hover:text-green-700 transition-colors"
                                    >
                                        Visit Website
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </a>
                                )}
                                {partner.secondLink && (
                                    <a
                                        href={partner.secondLink.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-1 text-sm font-semibold text-green-600 hover:text-green-700 transition-colors"
                                    >
                                        {partner.secondLink.label}
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </a>
                                )}
                            </div>
                        )}
                    </div>
                ))}
            </div>
        </div>
    </section>
)}
