<section id="signup" class="py-20 bg-gray-50">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <h2 class="text-3xl font-bold text-gray-900 mb-4">Registration is Now Closed</h2>
            <p class="text-lg text-gray-600 mb-8">
                The field is full. We'll see everyone on May 15th at Bear Slide Golf Club.
            </p>
            <a href="/the-field" class="inline-flex items-center justify-center px-6 py-3 bg-green-600 text-white text-base font-semibold rounded-lg hover:bg-green-700 transition-colors">
                See the Field
            </a>
        </div>
    </div>
</section>