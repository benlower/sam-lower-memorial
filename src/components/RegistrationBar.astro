---
// src/components/RegistrationBar.astro
// Toggle this to re-enable the live registration bar for future tournaments
const REGISTRATION_OPEN = false;

import { teams, singles, MAX_FOURSOMES } from '../data/registrants';

const maxPlayers = MAX_FOURSOMES * 4;
const totalPlayers = teams.reduce((sum, t) => sum + t.players.length, 0) + singles.length;
const spotsRemaining = maxPlayers - totalPlayers;
const pct = Math.round((totalPlayers / maxPlayers) * 100);
const filledWidth = `${(totalPlayers / maxPlayers) * 100}%`;
---

<a href="/the-field" class="block bg-green-800 hover:bg-green-700 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center gap-4">

        {REGISTRATION_OPEN ? (
            <>
                <!-- Progress bar -->
                <div class="flex-1 bg-green-900 rounded-full h-1.5 overflow-hidden min-w-0">
                    <div class="bg-green-400 h-full rounded-full transition-all" style={`width: ${filledWidth}`}></div>
                </div>

                <!-- Stats -->
                <div class="flex items-center gap-3 sm:gap-5 text-xs font-semibold text-green-100 whitespace-nowrap flex-shrink-0">
                    <span><span class="text-white">{totalPlayers}</span> / {maxPlayers} spots claimed</span>
                    <span class="hidden sm:inline text-green-600">|</span>
                    <span class="hidden sm:inline"><span class="text-white">{pct}%</span> full</span>
                    <span class="hidden sm:inline text-green-600">|</span>
                    <span class="hidden sm:inline"><span class="text-red-300">{spotsRemaining}</span> remaining</span>
                    <span class="text-green-300 flex items-center gap-1">
                        See The Field
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                        </svg>
                    </span>
                </div>
            </>
        ) : (
            <div class="flex items-center justify-between w-full text-xs font-semibold text-green-100 whitespace-nowrap">
                <span class="text-green-300">Registration Now Closed — The Field is Set</span>
                <span class="text-green-300 flex items-center gap-1">
                    See The Field
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                    </svg>
                </span>
            </div>
        )}

    </div>
</a>
