---
// src/components/EventRecap.astro
//
// ─── PHOTOS ──────────────────────────────────────────────────────────────────
// Drop event photos into:  src/images/event-2026/
// Supported formats: jpg, jpeg, png, webp, gif
// No code changes needed — they're picked up automatically at build time.
// ─────────────────────────────────────────────────────────────────────────────
//
// ─── MAILING LIST ────────────────────────────────────────────────────────────
// Public Google Form URL (no ?embedded=true — opens as a full page in a new tab):
const MAILING_LIST_FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSdvDFES88TH2CSvIKxKnGTgfwNqLUhbPzNmJ-n6z3pF3ycYoA/viewform';


// ─────────────────────────────────────────────────────────────────────────────

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
    '/src/images/event-2026/*.{jpg,jpeg,png,webp,gif,JPG,JPEG,PNG,WEBP}',
    { eager: true }
);

const photos = Object.entries(photoModules).map(([path, mod]) => ({
    src: mod.default.src,
    alt: path.split('/').pop()?.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ') ?? 'Event photo',
}));

const hasPhotos = photos.length > 0;
---

<section id="recap" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- ── Stats header ── -->
        <div class="text-center mb-16">
            <span class="inline-block px-3 py-1 text-sm font-medium bg-green-100 text-green-800 rounded-full mb-6">
                2026 Tournament · May 15th · Bear Slide Golf Club
            </span>
            <h2 class="text-4xl font-bold text-gray-900 mb-8">Thank You for a Wonderful Day</h2>

            <div class="inline-flex flex-col items-center bg-gradient-to-br from-green-500 to-green-700 text-white rounded-2xl px-12 py-8 mb-8 shadow-lg">
                <span class="text-6xl font-extrabold tracking-tight">~$3,000</span>
                <span class="text-lg font-medium opacity-90 mt-1">raised for cancer research</span>
            </div>

            <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
                The inaugural Sam Lower Memorial Golf Tournament was everything we hoped for — a day full of great golf, good company, and meaningful support for multiple myeloma research. Thank you to every player, sponsor, and donor who made it possible.
            </p>
        </div>

        <!-- ── Looking ahead + mailing list ── -->
        <div class="bg-gradient-to-br from-green-50 to-blue-50 rounded-2xl p-8 sm:p-10 mb-20 max-w-3xl mx-auto">
            <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mb-5">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">We'll Be Back</h3>
            <p class="text-gray-600 leading-relaxed mb-6">
                The first annual Sam Lower Memorial was just the beginning. We'll be returning in 2027 for another day of golf, community, and support for multiple myeloma research in Sam's honor. Join our mailing list and we'll reach out as soon as the 2027 tournament is announced — registration, sponsorships, and more.
            </p>
            {MAILING_LIST_FORM_URL ? (
                <a
                    href={MAILING_LIST_FORM_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white font-medium px-6 py-3 rounded-lg transition-colors shadow-sm"
                >
                    Join the mailing list
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            ) : (
                <p class="text-sm text-gray-400">Mailing list link coming soon.</p>
            )}
            <p class="text-xs text-gray-500 mt-3">Opens a Google Form in a new tab.</p>
        </div>

        <!-- ── Photo gallery ── -->
        <div>
            <h3 class="text-2xl font-bold text-gray-900 text-center mb-3">Event Photo Gallery</h3>
            <p class="text-center text-gray-600 max-w-2xl mx-auto mb-8">
                Have photos from the tournament you'd like to see here? Send them our way and we'll add them to the gallery.
            </p>

            {hasPhotos ? (
                <>
                    <!-- Carousel -->
                    <div id="recap-carousel" class="relative mb-6 rounded-2xl overflow-hidden shadow-xl bg-gray-900">
                        <div class="relative h-[480px]">
                            {photos.map((photo, i) => (
                                <img
                                    id={`recap-slide-${i}`}
                                    src={photo.src}
                                    alt={photo.alt}
                                    class={`absolute inset-0 w-full h-full object-contain transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                                    loading={i === 0 ? 'eager' : 'lazy'}
                                />
                            ))}
                        </div>

                        <!-- Prev / Next -->
                        {photos.length > 1 && (
                            <>
                                <button id="recap-prev" class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/75 text-white rounded-full p-3 transition-colors focus:outline-none" aria-label="Previous photo">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                    </svg>
                                </button>
                                <button id="recap-next" class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/75 text-white rounded-full p-3 transition-colors focus:outline-none" aria-label="Next photo">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                </button>

                                <!-- Counter -->
                                <div class="absolute top-4 right-4 bg-black/50 text-white px-3 py-1 rounded-full text-sm font-medium">
                                    <span id="recap-counter">1</span> / {photos.length}
                                </div>

                                <!-- Dots -->
                                <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex flex-wrap justify-center gap-2 max-w-sm">
                                    {photos.map((_, i) => (
                                        <button
                                            id={`recap-dot-${i}`}
                                            class={`w-2 h-2 rounded-full transition-all focus:outline-none ${i === 0 ? 'bg-white' : 'bg-white/40'} hover:bg-white`}
                                            aria-label={`Photo ${i + 1}`}
                                            data-index={i}
                                        />
                                    ))}
                                </div>
                            </>
                        )}
                    </div>

                    <!-- Thumbnail grid -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                        {photos.map((photo, i) => (
                            <button
                                class="relative aspect-square overflow-hidden rounded-lg bg-gray-100 hover:opacity-80 transition-opacity focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2"
                                data-carousel-index={i}
                                aria-label={`View photo ${i + 1}`}
                            >
                                <img
                                    src={photo.src}
                                    alt={photo.alt}
                                    class="absolute inset-0 w-full h-full object-cover"
                                    loading="lazy"
                                />
                            </button>
                        ))}
                    </div>
                </>
            ) : (
                <!-- Placeholder when no photos have been added yet -->
                <div class="rounded-2xl border-2 border-dashed border-gray-200 bg-gray-50 p-16 text-center">
                    <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <p class="text-lg font-medium text-gray-400">Photos coming soon</p>
                    <p class="text-sm text-gray-400 mt-1">
                        Drop event photos into <code class="bg-gray-100 px-1.5 py-0.5 rounded text-gray-500">src/images/event-2026/</code> to populate the gallery.
                    </p>
                </div>
            )}
        </div>

    </div>
</section>

<script define:vars={{ totalPhotos: photos.length }}>
    (function () {
        if (totalPhotos <= 1) return;

        let current = 0;
        let timer;
        let paused = false;

        const slides = Array.from({ length: totalPhotos }, (_, i) => document.getElementById(`recap-slide-${i}`));
        const dots   = Array.from({ length: totalPhotos }, (_, i) => document.getElementById(`recap-dot-${i}`));
        const counter = document.getElementById('recap-counter');

        function show(idx) {
            slides.forEach((s, i) => { if (s) s.style.opacity = i === idx ? '1' : '0'; });
            dots.forEach((d, i) => {
                if (!d) return;
                d.classList.toggle('bg-white',     i === idx);
                d.classList.toggle('bg-white/40',  i !== idx);
            });
            if (counter) counter.textContent = String(idx + 1);
            current = idx;
        }

        function next() { show((current + 1) % totalPhotos); }
        function prev() { show((current - 1 + totalPhotos) % totalPhotos); }

        function startTimer() { timer = setInterval(() => { if (!paused) next(); }, 4000); }
        function resetTimer()  { clearInterval(timer); startTimer(); }

        document.getElementById('recap-next')?.addEventListener('click', () => { next(); resetTimer(); });
        document.getElementById('recap-prev')?.addEventListener('click', () => { prev(); resetTimer(); });
        dots.forEach((d, i) => d?.addEventListener('click', () => { show(i); resetTimer(); }));

        // Clicking a thumbnail jumps the carousel and scrolls up to it
        document.querySelectorAll('[data-carousel-index]').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = parseInt(btn.getAttribute('data-carousel-index') ?? '0', 10);
                show(idx);
                resetTimer();
                document.getElementById('recap-carousel')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
        });

        const container = document.getElementById('recap-carousel');
        container?.addEventListener('mouseenter', () => { paused = true; });
        container?.addEventListener('mouseleave', () => { paused = false; });

        startTimer();
        window.addEventListener('beforeunload', () => clearInterval(timer));
    })();
</script>
