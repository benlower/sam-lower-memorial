---
// src/components/Footer.astro
---

<footer class="bg-gray-900 text-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <h3 class="text-2xl font-bold mb-4">In Loving Memory of Sam Lower</h3>
            <p class="text-gray-400 mb-6 max-w-2xl mx-auto">
                This tournament honors Sam's memory and continues his legacy of bringing people together through golf and community.
                Together, we can make a difference in the fight against multiple myeloma.
            </p>
            <div class="flex flex-wrap justify-center gap-6 mb-8">
                <a href="/#recap" class="text-gray-400 hover:text-white transition-colors">Event Recap</a>
                <a href="https://docs.google.com/forms/d/e/1FAIpQLSdvDFES88TH2CSvIKxKnGTgfwNqLUhbPzNmJ-n6z3pF3ycYoA/viewform" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors">Mailing List</a>
            </div>
            <div class="border-t border-gray-800 pt-8">
                <p class="text-gray-400 text-sm">
                    © 2026 The Sam Lower Memorial Golf Tournament. All rights reserved.
                </p>
            </div>
        </div>
    </div>
</footer>
